def start_new_run(state):
    """Bank broken: record it, restock the table, bring in a fresh croupier."""
    state["banks_broken"] += 1
    if not state["best_run"] or state["run_spins"] < state["best_run"]:
        state["best_run"] = state["run_spins"]
    restock_run(state)


def restock_run(state):
    """Start the next run: 100 chips, run counters cleared, a new croupier."""
    state["run"] += 1
    state["chips"] = STARTING_CHIPS
    for k in ("run_spins", "run_begs", "run_tipped", "run_rigs", "run_caught", "tip_pending",
              "pray_streak",
              "honest", "heat",
              "martingale", "last_stake", "last_net"):
        state[k] = 0
    state["tip_log"] = []
    replace_dealer(state)


