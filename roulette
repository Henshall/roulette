    if live:
        net = apply_round(state, bets, first, second, results)
        state["martingale"], state["last_stake"], state["last_net"] = mart, stake, net
        log_spin_tips(state)
        state["heat"] = max(0, state["heat"] - 1)
        state["pray_streak"] = 0
        if rig and rig["caught"]:
            state["caught"] += 1
            state["run_caught"] += 1
            state["tip_log"], state["tip_pending"] = [], 0
            state["honest"] = 1
            state["heat"] = PIT_BOSS_WATCH
