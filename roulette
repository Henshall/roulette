def did_you_mean(word, choices):
    match = difflib.get_close_matches(word, choices, n=1, cutoff=0.7)
    return match[0] if match else None

BET_USAGE = "bet as  <target> <chips>  or  <chips> <target>,  e.g.  red 10   10 red   5 on 17"


def _parse_bet_line(line, available):
    """Read a bet in either order: 'black 90', '90 black', '2 90', '90 2', '90 on 2'.

    When both words are numbers, whichever reading is a legal bet wins
    ('90 2' can only mean 90 chips on 2). If both readings are legal
    ('5 17'), ask the player to say '5 on 17' instead of guessing.
    """
    toks = line.split()
    lowered = [t.lower() for t in toks]
    if "on" in lowered[1:-1]:
        i = lowered.index("on", 1)
        readings = [(" ".join(toks[:i]), " ".join(toks[i + 1:]))]
    elif len(toks) >= 2:
        readings = [(toks[-1], " ".join(toks[:-1])), (toks[0], " ".join(toks[1:]))]
    else:
        raise ValueError(BET_USAGE)

    def build(stake_tok, target):
        if stake_tok.lower() in ("all", "max"):
            stake = available
        else:
            try:
                stake = int(stake_tok)
            except ValueError:
                raise ValueError(BET_USAGE) from None
        bet = parse_target(target)
        if stake <= 0:
            raise ValueError("you have nothing left to bet — try 'beg'" if available <= 0
                             else "a bet must be at least 1 chip")
        if stake > available:
            raise ValueError(f"you only have {available} 🪙 left to bet")
        bet["stake"] = stake
        return bet

    found, errors = [], []
    for stake_tok, target in readings:
        try:
            found.append(build(stake_tok, target))
        except ValueError as exc:
            errors.append(exc)
    if len(found) == 2 and found[0]["key"] != found[1]["key"]:
        x, y = found
        raise ValueError(f"'{line}' could go either way — say '{x['stake']} on {x['label']}'"
                         f" or '{y['stake']} on {y['label']}'")
    if found:
        return found[0]
    # Prefer a specific complaint (not enough chips, illegal bet) over usage.
    specific = [e for e in errors if str(e) != BET_USAGE]
    raise (specific[0] if specific else errors[0])


def _add_bet(bets, bet):
    for b in bets:
        if b["key"] == bet["key"]:
            b["stake"] += bet["stake"]
            return
    bets.append(bet)


