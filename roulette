# The crooked croupier remembers who tipped recently. Each chip you tip buys
# HELP_PER_CHIP of luck, up to HELP_MAX, and fades by 1/TIP_WINDOW every betting
# spin (a 1-chip tip: +2.5%, +2.25%, +2% ... gone after TIP_WINDOW spins). When
# you're about to lose, they rig the spin your way with that chance. The pit boss notices a rig with chance (rigged
# winnings / NOTICE_PER). Get caught: the bets are seized, your recent tips are
# wasted, and an honest croupier runs the rest of the run.
# Tuned so steady tipping with 25-chip bets lifts the odds of breaking the bank
# from 10% to ~30%, while over-tipping costs more than it's worth.
#
# Tip 0 and it counts as ZERO_TIP_PENALTY chips *against* you: luck can go
# negative, and an offended croupier then spoils winning spins with that chance.
TIP_WINDOW = 10
HELP_PER_CHIP = 0.025
HELP_MAX = 0.30
NOTICE_PER = 300
PIT_BOSS_WATCH = 5      # spins you must stay at the table after a bust
ZERO_TIP_PENALTY = -1   # each 0 tip: -2.5% luck
CAP_CHIPS = HELP_MAX / HELP_PER_CHIP  # tips beyond this are just gifts


def catch_chance(state, winnings):
    """How likely the pit boss spots a rig. It grows with the size of the
    rigged win, and doubles with every bust you've had this run: they know
    your face now, whichever table you sit at."""
    return min(0.9, winnings / NOTICE_PER * 2 ** state["run_caught"])


def recent_tips(state):
    """Your tips, faded by age: this spin's count fully, last spin's 90%, ..."""
    faded = sum(t * (TIP_WINDOW - age) / TIP_WINDOW
                for age, t in enumerate(reversed(state["tip_log"][-(TIP_WINDOW - 1):]), 1))
    return faded + state["tip_pending"]


def clamp_tips(state):
    """Keep luck within ±HELP_MAX. There's no hidden reserve: what you see is
    what you have, and tips past the cap are simply a gift."""
    over = recent_tips(state) - CAP_CHIPS
    under = -CAP_CHIPS - recent_tips(state)
    if over > 0:
        state["tip_pending"] -= over
    elif under > 0:
        state["tip_pending"] += under
    state["tip_pending"] = round(state["tip_pending"], 4)


def luck(state):
    """Your luck with the croupier, from -HELP_MAX to +HELP_MAX. An honest
    croupier never helps you, but can still hold a grudge."""
    value = max(-HELP_MAX, min(HELP_MAX, recent_tips(state) * HELP_PER_CHIP))
    return min(0.0, value) if state["honest"] else value


def help_chance(state):
    """Chance the croupier rigs your next losing spin your way."""
    return max(0.0, luck(state))


def spite_chance(state):
    """Chance an offended croupier spoils your next winning spin."""
    return max(0.0, -luck(state))


def luck_text(state):
    return f"🍀 {luck(state) * 100:+.1f}%".replace(".0%", "%")


def log_spin_tips(state):
    """A betted spin happened: roll this spin's tips into the window."""
    state["tip_log"] = (state["tip_log"] + [state["tip_pending"]])[-TIP_WINDOW:]
    state["tip_pending"] = 0


def rig_target(bets):
    """Pick the pocket the croupier aims for: one of your bets, weighted by stake."""
    total = sum(b["stake"] for b in bets)
    pick = random.uniform(0, total)
    for b in bets:
        pick -= b["stake"]
        if pick <= 0:
            break
    return random.choice(sorted(b["numbers"]))


def try_rig(state, bets, first, second, results):
    """If the croupier is on the take and you're losing, maybe rig the spin.

    Returns (first, second, results, rig) where rig is None, or a dict saying
    whether the pit boss `caught` it.
    """
    net = sum(p for _, _, p in results)
    if net > 0 and random.random() < spite_chance(state):
        spoilers = [n for n in range(1, 37)
                    if sum(p for _, _, p in settle_round(bets, n, None)) < 0]
        if spoilers:
            n = random.choice(spoilers)
            return n, None, settle_round(bets, n, None), {"caught": False, "spite": True}
    if net >= 0 or help_chance(state) <= 0:
        return first, second, results, None
    if random.random() >= help_chance(state):
        return first, second, results, None
    target = rig_target(bets)
    r_first, r_second = (0, random.randint(1, 36)) if target == 0 else (target, None)
    r_results = settle_round(bets, r_first, r_second)
    winnings = sum(p for _, won, p in r_results if won)
    if sum(p for _, _, p in r_results) <= 0:
        return first, second, results, None  # the aim was off; it wouldn't help
    if random.random() < catch_chance(state, winnings):
        seized = [(b, False, -b["stake"]) for b, _, _ in r_results]
        return r_first, r_second, seized, {"caught": True, "spite": False}
    return r_first, r_second, r_results, {"caught": False, "spite": False}


