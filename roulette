def pick_croupier(rng, name=None, exclude=None):
    """A croupier by name, or a random one (never `exclude`)."""
    roster = [c for c in CROUPIERS if c[0] == name] or \
        [c for c in CROUPIERS if c[0] != exclude] or CROUPIERS
    name, pron, lang, thanks, wow = rng.choice(roster)
    he, He, his, him, himself = _PRONOUNS[pron]
    return {"name": name, "he": he, "He": He, "his": his, "him": him, "himself": himself,
            "lang": lang, "thanks": thanks, "wow": wow}


