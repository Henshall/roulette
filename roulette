        out = subprocess.run(["bash", "-c", entropy_cmd], capture_output=True,
                             text=True, timeout=timeout).stdout
    except Exception:  # noqa: BLE001
        out = str(random.randint(0, 99999))
    color, n = _derive_color(out)
    raw = (out.strip().splitlines() or [str(n)])[0].strip()
    parity = "even" if n % 2 == 0 else "odd"
    print(f"  🔢 the wheel conjures  {style.bright(raw[:40])}  →  {n} is {parity}")
    _flash_wheel(style, color)
    emit("  " + style.slot(color, f"  ◉   {color.upper()}   WINS   ◉  "))

    if bet is None:
        emit(style.dim(f"  (no bet — {color.upper()} takes the round)"))
        return 0

    # Settle the bet against the derived color (super spins are red/black only).
    state = load_state()
    state["spins"] += 1
    won = target in ("red", "black") and target == color
    if won:
        profit = bet
        state["streak"] += 1
        bonus = (state["streak"] // 3) * bet
        profit += bonus
        state["chips"] += profit
        state["wins"] += 1
        state["best_streak"] = max(state["best_streak"], state["streak"])
        state["biggest_win"] = max(state["biggest_win"], profit)
        flair = style.bright(f"  🔥 streak x{state['streak']}") if bonus else ""
        emit(style.green(f"  ✅ YOU WIN  +{profit} 🪙") + flair
              + "    →    balance " + style.bright(f"{state['chips']} 🪙"))
    else:
        state["chips"] -= bet
        state["losses"] += 1
        state["streak"] = 0
        note = "" if target in ("red", "black") else style.dim(
            f"  (a super spin only pays red/black, not {target})")
        emit(style.red(f"  ❌ YOU LOSE  -{bet} 🪙") + note
              + "    →    balance " + style.bright(f"{state['chips']} 🪙"))
    if state["chips"] <= 0:
        emit(style.dim("  Out of chips — beg for more: roulette --beg"))
    save_state(state)
    return 0


# ---------------------------------------------------------------------------
# The real wheel: single-zero (European) layout with ZERO house edge.
#
# On a normal casino wheel the 0 is where the house makes its money: every
# bet pays as if there were 36 pockets, but there are 37. Here the 0 is a
# SUPER SPIN pocket instead:
#
#   * bets on 0 pay 36:1                      (1/37 * 36 - 36/37 = 0)
#   * every other bet rides a re-spin on 1-36 (0 is removed for the re-spin)
#
# so a bet covering k of the numbers 1-36 at the standard 36/k - 1 payout
# wins with probability exactly k/36 and has an expected value of exactly 0.
# Every loss has a matching way to win; the house keeps nothing.
# ---------------------------------------------------------------------------
WHEEL_ORDER = [0, 32, 15, 19, 4, 21, 2, 25, 17, 34, 6, 27, 13, 36, 11, 30, 8,
               23, 10, 5, 24, 16, 33, 1, 20, 14, 31, 9, 22, 18, 29, 7, 28, 12,
               35, 3, 26]
SUPER_WHEEL_ORDER = [n for n in WHEEL_ORDER if n != 0]
RED_NUMBERS = frozenset({1, 3, 5, 7, 9, 12, 14, 16, 18, 19, 21, 23, 25, 27,
                         30, 32, 34, 36})
_ONE_TO_36 = range(1, 37)

OUTSIDE_BETS = {
    "red":    ("RED",       RED_NUMBERS),
    "black":  ("BLACK",     frozenset(n for n in _ONE_TO_36 if n not in RED_NUMBERS)),
    "odd":    ("ODD",       frozenset(n for n in _ONE_TO_36 if n % 2)),
    "even":   ("EVEN",      frozenset(n for n in _ONE_TO_36 if n % 2 == 0)),
    "low":    ("1-18",      frozenset(range(1, 19))),
    "high":   ("19-36",     frozenset(range(19, 37))),
    "dozen1": ("1st 12",    frozenset(range(1, 13))),
    "dozen2": ("2nd 12",    frozenset(range(13, 25))),
    "dozen3": ("3rd 12",    frozenset(range(25, 37))),
    "col1":   ("column 1",  frozenset(range(1, 37, 3))),
    "col2":   ("column 2",  frozenset(range(2, 37, 3))),
    "col3":   ("column 3",  frozenset(range(3, 37, 3))),
}
BET_ALIASES = {
    "r": "red", "b": "black", "rouge": "red", "noir": "black",
    "impair": "odd", "pair": "even", "manque": "low", "passe": "high",
    "1-18": "low", "19-36": "high",
    "d1": "dozen1", "1st12": "dozen1", "first12": "dozen1", "1-12": "dozen1",
    "d2": "dozen2", "2nd12": "dozen2", "second12": "dozen2", "13-24": "dozen2",
    "d3": "dozen3", "3rd12": "dozen3", "third12": "dozen3", "25-36": "dozen3",
    "c1": "col1", "column1": "col1", "c2": "col2", "column2": "col2",
    "c3": "col3", "column3": "col3",
    "zero": "0", "green": "0", "g": "0",
}

BET_HELP = """\
  outside   red  black  odd  even  low (1-18)  high (19-36)        pay 1:1
            d1 d2 d3 (dozens)   col1 col2 col3 (columns)            pay 2:1
  inside    17 (straight, 35:1)   17/18 or 17/20 (split, 17:1)
            7-9 (street, 11:1)    1/2/4/5 (corner, 8:1)   1-6 (six line, 5:1)
  zero      0 or green (36:1 — lands on 0, everything else gets a SUPER SPIN)"""


def number_color(n):
    if n == 0:
        return "green"
    return "red" if n in RED_NUMBERS else "black"


def payout_for(numbers):
    """Fair payout (net profit multiple) for a bet covering `numbers`."""
    if numbers == {0}:
        return 36
    return 36 // len(numbers) - 1


def _inside_kind(nums):
    """Name the inside bet covering `nums`, or None if it isn't a legal one."""
    s = sorted(nums)
    if s == [0]:
        return "straight"
    if not s or any(not 1 <= x <= 36 for x in s):
        return None
    a, k = s[0], len(s)
    if k == 1:
        return "straight"
    if k == 2 and (s[1] - a == 3 or (s[1] - a == 1 and a % 3 != 0)):
        return "split"
    if k == 3 and a % 3 == 1 and s == [a, a + 1, a + 2]:
        return "street"
    if k == 4 and a % 3 != 0 and s == [a, a + 1, a + 3, a + 4]:
        return "corner"
    if k == 6 and a % 3 == 1 and s == list(range(a, a + 6)):
        return "six line"
    return None


def parse_target(text):
    """Turn 'red', '17', '17/18', '7-9', 'd2', ... into a bet dict (no stake)."""
    t = text.strip().lower().replace(" ", "")
    t = BET_ALIASES.get(t, t)
    if t in OUTSIDE_BETS:
        lbl, nums = OUTSIDE_BETS[t]
        return {"key": t, "label": lbl, "numbers": nums, "payout": payout_for(nums)}
    try:
        if re.fullmatch(r"\d+-\d+", t):
            a, b = sorted(int(x) for x in t.split("-"))
            nums = frozenset(range(a, b + 1))
        else:
            parts = [x for x in re.split(r"[,/+-]", t) if x]
            if not parts:
                raise ValueError
            nums = frozenset(int(x) for x in parts)
    except ValueError:
        raise ValueError(f"don't know how to bet on '{text}'") from None
    for key, (lbl, onums) in OUTSIDE_BETS.items():
        if nums == onums:
            return {"key": key, "label": lbl, "numbers": onums, "payout": payout_for(onums)}
    kind = _inside_kind(nums)
    if kind is None:
        raise ValueError(f"'{text}' isn't a legal bet on the table "
                         "(splits/corners must be neighbours on the layout)")
    s = sorted(nums)
    if kind == "straight":
        lbl = "0 (zero)" if s == [0] else str(s[0])
    elif kind in ("street", "six line"):
        lbl = f"{kind} {s[0]}-{s[-1]}"
    else:
        lbl = f"{kind} " + "/".join(map(str, s))
    key = "/".join(map(str, s))
    return {"key": key, "label": lbl, "numbers": nums, "payout": payout_for(nums)}


def describe_number(n):
    if n == 0:
        return "ZERO"
    parts = [number_color(n).upper(), "ODD" if n % 2 else "EVEN",
             "LOW" if n <= 18 else "HIGH", ("1st", "2nd", "3rd")[(n - 1) // 12] + " 12",
             f"col {(n - 1) % 3 + 1}"]
    return " · ".join(parts)


def pocket_text(style, n, width=4):
    return style.pocket(number_color(n), f"{n:^{width}}")


def render_table(style):
    """The felt: 0 on the left, 3 rows of 12, then dozens and even-money boxes."""
    lines = []
    cw = 4 if term_width() >= 72 else 3  # narrow terminals get a compact felt
    rows = [range(3, 37, 3), range(2, 37, 3), range(1, 37, 3)]
    for i, row in enumerate(rows):
        zero = style.pocket("green", "  0  " if i == 1 else "     ")
        cells = "".join(style.pocket(number_color(n), f"{n:^{cw}}") for n in row)
        lines.append("  " + zero + "│" + cells + "│ "
                     + style.dim(f"col{3 - i}" + (" 2:1" if cw == 4 else "")))
    pad = "  " + " " * 5 + " "
    dozens = ("1st 12 · d1", "2nd 12 · d2", "3rd 12 · d3") if cw == 4 else ("d1", "d2", "d3")
    lines.append(pad + "".join(style.dim(f"{d:^{cw * 4}}") for d in dozens))
    evens = [("1-18", None), ("EVEN", None), ("RED", "red"), ("BLACK", "black"),
             ("ODD", None), ("19-36", None)]
    lines.append(pad + "".join(style.pocket(c, f"{t:^{cw * 2}}") if c
                                else style.dim(f"{t:^{cw * 2}}") for t, c in evens))
    return lines


def print_table(style, brief=False):
    print()
    for line in render_table(style):
        print(line)
    print()
    if brief:
        return
    for line in BET_HELP.splitlines():
        emit(line, keep=12)
    print()
    emit("  " + style.pocket("green", " 0 ") + style.accent(" = SUPER SPIN")
          + style.dim(" — bets on 0 pay 36:1, every other bet rides a re-spin on 1–36."))
    emit(style.dim("  Every bet has an expected value of exactly zero.  House edge: ")
          + style.bright("0.00%"))
    emit(style.dim("  (Your croupier, on the other hand, can be bribed.)"))


def wheel_spin(style, order, result, *, frames=62):
    """Animate a horizontal strip of the wheel sliding under the ball."""
    n = len(order)
    width = term_width()
    visible = max(5, min(15, (width - 6) // 4))
    if visible % 2 == 0:
        visible -= 1
    half = visible // 2
    end = order.index(result) + 3 * n
    start = end - (frames - 1)

    start_delay, end_delay = 0.012, 0.30
    delays = [start_delay + (end_delay - start_delay) * ((i / (frames - 1)) ** 2.6)
              for i in range(frames)]

    bar = "─" * (visible * 4)
    marker = " " * (3 + half * 4)

    def render(center, landed=False):
        cells = []
        for off in range(-half, half + 1):
            num = order[(center + off) % n]
            if off == 0 and not style.enabled:
                cells.append(f"[{num:>2}]")
            else:
                cells.append(pocket_text(style, num))
        ball = style.bright(" ●" if landed else " ▼")
        return [marker + ball, "  ┌" + bar + "┐", "  │" + "".join(cells) + "│",
                "  └" + bar + "┘", marker + style.bright(" ▲")]

    out = sys.stdout
    out.write(HIDE_CURSOR)
    try:
        for f in range(frames):
            if _ANIM["skip"] and 0 < f < frames - 1:
                continue
            lines = render(start + f, landed=(f == frames - 1))
            if f:
                out.write(f"\033[{len(lines)}A")
            out.write("\r" + "\n".join(l + CLEAR_LINE for l in lines) + "\n")
            out.flush()
            pause(delays[f])
    finally:
        out.write(SHOW_CURSOR)
        out.flush()


def announce(style, n, prefix="🎯"):
    emit("  " + prefix + "  " + style.pocket(number_color(n), f"  {n}  ")
          + "  " + style.bright(describe_number(n)))


def _flash_felt(style, cycles=18):
    """Light up the table for a super spin: flash red / black / green."""
    out = sys.stdout
    if not out.isatty() or not style.enabled:
        return
    width = min(term_width(), 60) - 4
    colors = ("red", "black", "green")
    out.write(HIDE_CURSOR)
    try:
        for i in range(cycles):
            if _ANIM["skip"]:
                break
            out.write("\r  " + style.pocket(colors[i % 3], " " * width))
            out.flush()
            pause(0.03 + (i / cycles) * 0.12)
        out.write("\r" + CLEAR_LINE)
        out.flush()
    finally:
        out.write(SHOW_CURSOR)
        out.flush()


def throw_ball():
    """Return (first, second): second is the super-spin number when first == 0."""
    first = random.randrange(37)
    second = random.randint(1, 36) if first == 0 else None
    return first, second


def settle_round(bets, first, second):
    """Resolve every bet. Returns [(bet, outcome, profit)] with outcome win|lose."""
    results = []
    for b in bets:
        if first in b["numbers"]:
            won = True
        elif first == 0:
            won = second in b["numbers"]  # rides the super spin
        else:
            won = False
        profit = b["stake"] * b["payout"] if won else -b["stake"]
        results.append((b, won, profit))
    return results


def apply_round(state, bets, first, second, results):
    net = sum(p for _, _, p in results)
    stake = sum(b["stake"] for b in bets)
    state["chips"] += net
    state["spins"] += 1
    state["run_spins"] += 1
    state["wagered"] += stake
    state["net"] += net
    if net > 0:
        state["wins"] += 1
        state["streak"] += 1
        state["best_streak"] = max(state["best_streak"], state["streak"])
        state["biggest_win"] = max(state["biggest_win"], net)
    elif net < 0:
        state["losses"] += 1
        state["streak"] = 0
    else:
        state["pushes"] += 1
    state["history"] = (state["history"] + [f"0>{second}" if first == 0 else str(first)])[-HISTORY_LEN:]
    return net


def format_history(style, history, limit=12):
    out = []
    for h in history[-limit:]:
        if h.startswith("0>"):
            try:
                n = int(h[2:])
            except ValueError:
                continue
            out.append(style.pocket("green", " 0") + style.pocket(number_color(n), f"→{n} "))
        else:
            try:
                n = int(h)
            except ValueError:
                continue
            out.append(style.pocket(number_color(n), f" {n} "))
    return " ".join(out)


