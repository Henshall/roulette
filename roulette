def result_quip(style, state, results, net, mart_level, chips_before, mood=""):
    """React to the spin. `mood` is "friend" (you've been tipping), "spite"
    (you insulted them with 0 tips) or "" (neutral, with a little resentment)."""
    def react(key, chance=1.0, **kw):
        say(style, f"{key}_{mood}" if f"{key}_{mood}" in QUIPS else key, chance, **kw)

    stake = sum(b["stake"] for b, _, _ in results)
    if state is not None and state["chips"] <= 0:
        if mart_level >= 2:
            croak(style, MARTINGALE_BUST)
        else:
            react("broke")
    elif net > 0 and mart_level >= 2:
        croak(style, MARTINGALE_PAYOFF, net=net)
    elif net > 0 and net >= max(50, stake * 5):
        react("big_win", net=net)
    elif net > 0:
        react("win", 0.6, net=net)
    elif net == 0:
        react("push", 0.8)
    elif -net >= max(50, chips_before // 2):
        react("big_loss", lost=-net)
    else:
        react("lose", 0.5)


def play_round(style, bets, *, animate, dry_run=False, state=None):
