                print(f"  • {b['label']:<18} {b['stake']:>6} 🪙  pays {b['payout']}:1")
            continue
        if cmd in ("u", "undo"):
            if bets:
                b = bets.pop()
                emit(style.dim(f"  picked up {b['stake']} 🪙 from {b['label']}"))
            continue
        if cmd in ("c", "clear"):
            bets = []
            emit(style.dim("  you pick up your chips"))
            continue
        if cmd in ("r", "rebet", "again"):
            if not last:
                emit(style.dim("  nothing to repeat yet — place a bet first, e.g.  red 10"))
                continue
            if sum(b["stake"] for b in last) > free:
                emit(style.dim("  not enough chips to repeat your last bets"))
                continue
            for b in last:
                _add_bet(bets, dict(b))
            emit(style.dim("  re-betting: " + ", ".join(
                f"{b['stake']} on {b['label']}" for b in last) + "  (Enter to spin)"))
            continue
        if cmd in ("", "s", "spin", "go"):
            if not bets:
                # A free spin: just watch the wheel. No chips, stats or history.
                with skippable():
                    play_round(style, [], animate=animate, dry_run=True)
                emit(style.dim("  (free spin — no bets on the table, no chips moved)"))
                continue
            with skippable():
                play_round(style, bets, animate=animate, state=state)
            last, bets = [dict(b) for b in bets], []
            hist = format_history(style, state["history"])
            if hist:
                emit(style.dim("  recent: ") + hist)
            continue
        if not any(ch.isdigit() for ch in cmd) and not {"all", "max"} & set(cmd.split()):
            guess = did_you_mean(cmd, TABLE_COMMANDS)
            emit(style.red(f"  '{line}' isn't something the table understands")
                 + style.dim(f" — did you mean  {guess} ?" if guess else
                             " — type  help  for the list"))
            continue
        try:
            bet = _parse_bet_line(line, free)
        except ValueError as exc:
            msg = str(exc)
            m = re.match(r"don't know how to bet on '(.+)'", msg)
            guess = m and did_you_mean(m.group(1).lower(),
                                       list(OUTSIDE_BETS) + list(BET_ALIASES))
            emit(style.red(f"  {msg}") + (style.dim(f" — did you mean  {guess} ?") if guess else ""))
            continue
        _add_bet(bets, bet)
        emit(style.dim(f"  {bet['stake']} 🪙 on {bet['label']} (pays {bet['payout']}:1)"))
        bet_quip(style, bet, state["chips"], free)


