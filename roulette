    stake = sum(b["stake"] for b in bets)
    history_before = list(state["history"]) if state is not None else []
    live = state is not None and not dry_run and bool(bets)
    chips_before = state["chips"] if state is not None else 0
    mart = martingale_level(state, stake) if live else 0
    sulking = live and spite_chance(state) > 0
    mood = "friend" if (live and luck(state) > 0) else "spite" if sulking else ""
    on_the_take = live and help_chance(state) > 0
    rig = None
    if live:
        first, second, results, rig = try_rig(state, bets, first, second, results)
    old_dealer = dict(DEALER)
