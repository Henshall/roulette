def _build_slot_meta(commands):
    """Map each command -> {'color': red|black|green, 'kind': normal|marquee|loser}."""
    meta = {}
    i = 0
    for cmd in commands:
        if cmd in _SUPER_SET:
            meta[cmd] = {"color": "super", "kind": "super"}
        elif cmd in _LOSING_SET:
            meta[cmd] = {"color": "green", "kind": "loser"}
        else:
            kind = "marquee" if any(m in cmd for m in MARQUEE_MARKERS) else "normal"
            meta[cmd] = {"color": "red" if i % 2 == 0 else "black", "kind": kind}
            i += 1
    return meta


SLOT_META = _build_slot_meta(COMMANDS)


def slot_color(cmd):
    return SLOT_META.get(cmd, {}).get("color", "black")


def slot_kind(cmd):
    return SLOT_META.get(cmd, {}).get("kind", "normal")


def _counts():
    reds = blacks = greens = marquees = 0
    for m in SLOT_META.values():
        if m["color"] == "green":
            greens += 1
        elif m["color"] == "red":
            reds += 1
        elif m["color"] == "black":
            blacks += 1
        # 'super' pockets are wild (resolved at spin time) — not counted here
        if m["kind"] == "marquee":
            marquees += 1
    return reds, blacks, greens, marquees


def payout_mult(target):
    """Net profit multiplier for a winning bet on `target`."""
    reds, blacks, greens, marquees = _counts()
    total = reds + blacks + greens
    if target == "green":
        return max(2, min(30, total // max(greens, 1) - 1))
    if target == "jackpot":
        return max(5, min(40, total // max(marquees, 1) - 1))
    return 1  # red / black pay even money (the green pockets are the house edge)


def resolve_bet(target, cmd):
    """Return (won: bool, profit_mult) for a bet on `target` landing on `cmd`."""
    color, kind = slot_color(cmd), slot_kind(cmd)
    if target == "jackpot":
        won = kind == "marquee"
    elif target == "green":
        won = color == "green"
    else:
        won = color == target
    return won, (payout_mult(target) if won else 0)


def load_state():
    try:
        with open(STATE_FILE) as f:
            data = json.load(f)
        state = fresh_state()
        for k, default in DEFAULT_STATE.items():
            if isinstance(default, list):
                if isinstance(data.get(k), list):
                    if k == "history":
                        state[k] = [str(x) for x in data[k]][-HISTORY_LEN:]
                    else:
                        state[k] = [x for x in data[k]
                                    if isinstance(x, (int, float))][-HISTORY_LEN:]
            elif isinstance(default, str):
                if isinstance(data.get(k), str):
                    state[k] = data[k]
            elif isinstance(data.get(k), int) or (k == "tip_pending"
                                                   and isinstance(data.get(k), float)):
                state[k] = data[k]
        # A bust saved under an older, longer pit-boss watch still only lasts
        # PIT_BOSS_WATCH spins.
        state["heat"] = max(0, min(state["heat"], PIT_BOSS_WATCH))
        return state
    except Exception:  # noqa: BLE001 - missing/corrupt state -> fresh bankroll
        return fresh_state()


def fresh_state():
    state = dict(DEFAULT_STATE)
    state["history"] = []
    state["tip_log"] = []
    state["events_seen"] = []
    return state


def save_state(state):
    try:
        os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
        tmp = STATE_FILE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(state, f)
        os.replace(tmp, STATE_FILE)  # atomic
    except Exception:  # noqa: BLE001 - never let a save failure crash a spin
        pass


# ---------------------------------------------------------------------------
# ANSI helpers
# ---------------------------------------------------------------------------
class Style:
    def __init__(self, enabled):
        self.enabled = enabled

    def _wrap(self, code, text):
        if not self.enabled:
            return text
        return f"\033[{code}m{text}\033[0m"

    def dim(self, t):
        return self._wrap("2;37", t)

    def bright(self, t):
        return self._wrap("1;33", t)

    def win(self, t):
        return self._wrap("1;30;43", t)  # black on yellow

    def accent(self, t):
        return self._wrap("1;36", t)

    def green(self, t):
        return self._wrap("1;32", t)

    def red(self, t):
        return self._wrap("1;31", t)

    def pocket(self, color, t):
        """A pocket on the real wheel: white text on a red/black/green felt."""
        code = {"red": "1;97;41", "black": "1;97;40", "green": "1;97;42"}.get(color, "0")
        return self._wrap(code, t)

    def slot(self, color, t):
        code = {"red": "1;31", "black": "1;37", "green": "1;32",
                "super": "1;35"}.get(color, "0;37")
        return self._wrap(code, t)


HIDE_CURSOR = "\033[?25l"
SHOW_CURSOR = "\033[?25h"
CLEAR_LINE = "\033[K"


def term_width(default=80):
    try:
        cols = shutil.get_terminal_size((default, 24)).columns
    except Exception:
        return default
    # Some terminals report 0 columns; Python 3.11+ treats that as unknown,
    # older versions (like macOS's 3.9) pass it through.
    return cols if cols > 0 else default


_ANSI_RE = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]")
_LEAD_RE = re.compile(r"^((?:\x1b\[[0-9;?]*[A-Za-z])*)( *)")


def cell_width(text):
    """How many terminal columns `text` takes (colours ignored, emoji are 2)."""
    w = 0
    for ch in _ANSI_RE.sub("", text):
        if ch in "\u200d\ufe0e\ufe0f" or unicodedata.combining(ch):
            continue
        w += 2 if unicodedata.east_asian_width(ch) in "WF" else 1
    return w


def emit(text="", hang=None, keep=0):
    """Print `text`, word-wrapped to the terminal if it's too wide.

    Continuation lines are indented by `hang` columns (default: under the
    first word, or under the text after a leading emoji). The first `keep`
    characters are printed as-is, so a column of labels keeps its alignment."""
    width = max(30, term_width() - 1)
    if cell_width(text) <= width:
        print(text)
        return
    if keep:
        codes, lead = "", text[:keep]
        words = [w for w in text[keep:].split(" ") if w]
        hang = keep if hang is None else hang
    else:
        m = _LEAD_RE.match(text)
        codes, lead = m.group(1), m.group(2)
        words = [w for w in text[m.end():].split(" ") if w]
    if hang is None:
        hang = len(lead)
        first = _ANSI_RE.sub("", words[0]) if words else ""
        if first and not any(c.isalnum() for c in first) and cell_width(first) <= 3:
            hang += cell_width(first) + 1
    hang = min(hang, width // 2)
    lines, cur, cur_w = [], codes + lead, len(lead)
    fresh = True
    for word in words:
        w = cell_width(word)
        if not fresh and cur_w + 1 + w > width:
            lines.append(cur)
            cur, cur_w, fresh = " " * hang, hang, True
        if fresh:
            cur, cur_w, fresh = cur + word, cur_w + w, False
        else:
            cur, cur_w = cur + " " + word, cur_w + 1 + w
    lines.append(cur)
    print("\n".join(lines))


# Animations can be skipped (press Enter) or sped up (the `fast` command).
_ANIM = {"skip": False, "armed": False, "fast": False}
FAST_FACTOR = 0.35


def pause(sec):
    """Sleep for an animation beat, unless the player has skipped ahead."""
    if _ANIM["skip"]:
        return
    if _ANIM["fast"]:
        sec *= FAST_FACTOR
    if _ANIM["armed"]:
        try:
            if select.select([sys.stdin], [], [], sec)[0]:
                _ANIM["skip"] = True
            return
        except (OSError, ValueError):
            pass
    time.sleep(sec)


@contextlib.contextmanager
def skippable():
    """While the show plays, Enter skips to the end. Keys aren't echoed (so the
    wheel isn't scribbled on) and are thrown away afterwards (so an extra
    Enter can't start another spin)."""
    _ANIM["skip"] = False
    fd, old = None, None
    if termios is not None and sys.stdin.isatty() and sys.stdout.isatty():
        try:
            fd = sys.stdin.fileno()
            old = termios.tcgetattr(fd)
            quiet = termios.tcgetattr(fd)
            quiet[3] &= ~termios.ECHO
            termios.tcsetattr(fd, termios.TCSANOW, quiet)
            _ANIM["armed"] = True
        except (termios.error, OSError, ValueError):
            fd = None
    try:
        yield
    finally:
        _ANIM["armed"] = False
        _ANIM["skip"] = False
        if fd is not None:
            try:
                termios.tcflush(fd, termios.TCIFLUSH)
                termios.tcsetattr(fd, termios.TCSANOW, old)
            except (termios.error, OSError):
                pass


def label(cmd, width):
    """One-line display label for a command (truncate if needed)."""
    cmd = cmd.replace("\n", " ")
    if len(cmd) > width:
        cmd = cmd[: width - 1] + "…"
    return cmd


