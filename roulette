_last_quip = {}


def say(style, key, chance=1.0, **kw):
    """The croupier comments, maybe. Never repeats the same line twice in a row."""
    lines = QUIPS[key]
    if FLAVOR.random() >= chance:
        return
    options = [l for l in lines if l != _last_quip.get(key)] or lines
    line = FLAVOR.choice(options)
    _last_quip[key] = line
    croak(style, line, **kw)


def croak(style, text, **kw):
    who = fx("🎩 {name}:")
    hang = 2 + cell_width(who) + 1
    emit("  " + style.accent(who) + " " + fx(text, **kw), hang=hang if hang <= 24 else 4)


def bet_quip(style, bet, chips, free):
    """React to a fresh bet. `free` is what the player had left before it."""
    n = len(bet["numbers"])
    kw = {"label": bet["label"], "stake": bet["stake"]}
    if bet["stake"] >= free and bet["stake"] > 1:
        say(style, "all_in", **kw)
    elif chips and bet["stake"] * 2 >= chips and bet["stake"] > 1:
        say(style, "big", **kw)
    elif bet["numbers"] == {0}:
        say(style, "zero", 0.7, **kw)
    elif n == 1:
        say(style, "straight", 0.7, **kw)
    elif n == 18:
        say(style, "even", 0.5, **kw)
    elif n == 12:
        say(style, "outside2", 0.5, **kw)
    else:
        say(style, "inside", 0.6, **kw)


def ball_misbehaves(style, animate):
    """Once in a while the ball escapes. Purely theatre: the result is unchanged."""
    if FLAVOR.randrange(MISBEHAVE_ODDS):
        return False
    print()
    emit("  " + style.red("⚠  BALL ESCAPE  ⚠"))
    for line in FLAVOR.choice(MISBEHAVIOURS):
        emit("  " + style.dim(fx(line)))
        sys.stdout.flush()
        if animate:
            pause(0.8)
    return True


