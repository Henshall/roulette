def term_width(default=80):
    try:
        return shutil.get_terminal_size((default, 24)).columns
    except Exception:
        return default


def label(cmd, width):
    """One-line display label for a command (truncate if needed)."""
    cmd = cmd.replace("\n", " ")
    if len(cmd) > width:
        cmd = cmd[: width - 1] + "…"
    return cmd


# ---------------------------------------------------------------------------
# The spin animation
# ---------------------------------------------------------------------------
def _alternating_order(commands, color_of):
    """Lay commands out so colors go red / black / red / black, greens sprinkled
    (like the 0 pockets on a real wheel)."""
    reds = [c for c in commands if color_of(c) == "red"]
    blacks = [c for c in commands if color_of(c) == "black"]
    specials = [c for c in commands if color_of(c) not in ("red", "black")]  # green/super
    out = []
    for i in range(max(len(reds), len(blacks))):
        if i < len(reds):
            out.append(reds[i])
        if i < len(blacks):
            out.append(blacks[i])
    if specials:
        step = max(1, len(out) // len(specials))
        for k, s in enumerate(specials):
            out.insert(min(len(out), k * step + step // 2 + k), s)
    return out


def spin(commands, style, *, frames=55, window=7, keep_wheel=False, color_of=None):
    """Animate a scrolling reel and return the winning command."""
    width = min(term_width(), 72)
    inner = width - 10  # room for the pointer/markers
    half = window // 2

    # Build the reel. With colors, lay pockets out in a fixed alternating ring
    # (red/black/…) and rotate it so a uniformly-random winner lands at center —
    # the colors stay alternating while the outcome is still fair.
    needed = frames + window + 4
    center_final = half + (frames - 1)
    if color_of is not None:
        ordered = _alternating_order(commands, color_of)
        n = len(ordered)
        picked = random.choice(commands)
        offset = (ordered.index(picked) - center_final) % n
        rotated = ordered[offset:] + ordered[:offset]
    else:
        rotated = commands[:]
        random.shuffle(rotated)
        n = len(rotated)
    reel = rotated * (needed // n + 2)

    # Ease-out delays: start fast, end slow.
    start_delay, end_delay = 0.010, 0.22
    delays = []
    for i in range(frames):
        t = i / (frames - 1) if frames > 1 else 1.0
        delays.append(start_delay + (end_delay - start_delay) * (t ** 2.3))

    bar = "═" * (width - 2)
    top = "╔" + bar + "╗"
    bottom = "╚" + bar + "╝"
    block_lines = window + 2  # borders

    def render(center_idx):
        lines = [style.accent(top)]
        for off in range(-half, half + 1):
            cmd = reel[center_idx + off]
            text = label(cmd, inner)
            if off == 0:
                content = f" ▶  {text}"
                content = content.ljust(width - 6)
                row = "║ " + style.win(content) + " ◀ ║"
            else:
                shown = style.slot(color_of(cmd), text) if color_of else style.dim(text)
                pad = width - 4 - len(label(cmd, inner))
                row = "║  " + shown + (" " * max(pad, 0)) + " ║"
            lines.append(row)
        lines.append(style.accent(bottom))
        return lines

    out = sys.stdout
    out.write(HIDE_CURSOR)
    winner = reel[half]
    try:
        for f in range(frames):
            center = half + f
            winner = reel[center]
            lines = render(center)
            if f > 0:
                out.write(f"\033[{block_lines}A")  # move cursor up to redraw
            out.write("\r")
            out.write(("\n").join(l + CLEAR_LINE for l in lines))
            out.write("\n")
            out.flush()
            time.sleep(delays[f])
        if not keep_wheel:
            time.sleep(0.4)                       # let the landing register
            out.write(f"\033[{block_lines}A")     # back to the top of the box
            out.write("\033[J")                   # erase the box (and below)
            out.flush()
    finally:
        out.write(SHOW_CURSOR)
        out.flush()
    return winner


def _list_entries():
    """Every file and folder in the current directory (names only, incl. dotfiles)."""
    return sorted(os.listdir("."))


def _trash_path(path):
    """Move a file or folder to the trash (recoverable). Returns where it went."""
    base = os.path.basename(path.rstrip("/"))
    if platform.system() == "Darwin":
        # macOS: move into ~/.Trash (restorable from Finder).
        trash = os.path.expanduser("~/.Trash")
        if os.path.isdir(trash):
            target = os.path.join(trash, base)
            if os.path.exists(target):
                target += "-" + time.strftime("%H%M%S")
            shutil.move(path, target)
            return "~/.Trash"
    elif shutil.which("gio"):
        # Linux desktops: gio trash, restorable from the file manager.
        r = subprocess.run(
            ["gio", "trash", path],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
        if r.returncode == 0:
            return "Trash"
    # Fallback: move into a timestamped recovery folder under $HOME.
    stamp = time.strftime("%Y%m%d-%H%M%S")
    dest = os.path.join(os.path.expanduser("~"), ".local", "share",
                        "roulette-trash", stamp)
    os.makedirs(dest, exist_ok=True)
    shutil.move(path, os.path.join(dest, base))
    return dest


def russian_roulette(style, dry_run):
    """The russian slot: move every file and folder in the current dir to the trash."""
    entries = _list_entries()
    print()
    print(style.red("  ☠  R U S S I A N   R O U L E T T E  ☠"))
    print(style.dim("  Chamber: " + os.getcwd()))
    print()

    if not entries:
        print(style.green("  This directory is empty — *click*. You live."))
        return 0

    print(style.dim("  In the chamber:"))
    for e in entries:
        tag = "/" if os.path.isdir(e) and not os.path.islink(e) else ""
        print("    - " + e + tag)
    print()

    if dry_run:
        print(style.dim("  (dry run — nothing deleted)"))
        return 0

    if not sys.stdin.isatty():
        print(style.red("  Refusing to delete without an interactive confirmation."))
        return 1

    print(style.red(f"  All {len(entries)} item(s) here will be moved to the TRASH (recoverable)."))
    try:
        ans = input("  Type 'bang' to pull the trigger (anything else = chicken out): ")
    except (EOFError, KeyboardInterrupt):
        print(style.green("\n  You chickened out. Everything is safe."))
        return 0
    if ans.strip().lower() != "bang":
        print(style.green("  You chickened out. Everything is safe."))
        return 0

    trashed, failed, where = [], [], "Trash"
    for e in entries:
        try:
            where = _trash_path(e)
            trashed.append(e)
        except Exception as exc:  # noqa: BLE001
            failed.append((e, exc))

    print()
    if trashed:
        print(style.red(f"  💥 BANG. Trashed {len(trashed)} item(s): ")
              + ", ".join(trashed))
        print(style.dim(f"  Recover from: {where}"))
    for e, exc in failed:
        print(style.red(f"  Could not trash {e}: {exc}"))
    return 0 if not failed else 1


def run_command(cmd, style, timeout, header="  🎯 Landed on:", header_color="green"):
    if cmd == RUSSIAN:
        return russian_roulette(style, dry_run=False)
    print()
    paint = getattr(style, header_color, style.green)
    print(paint(header), style.bright(cmd))
    print(style.dim("  " + "─" * 50))
    print()
    sys.stdout.flush()  # ensure our header prints before the subprocess output
    try:
        result = subprocess.run(
            ["bash", "-c", cmd],
            timeout=timeout,
        )
        return result.returncode
    except subprocess.TimeoutExpired:
        print(style.red(f"\n  (command timed out after {timeout}s)"))
        return 124
    except FileNotFoundError:
        print(style.red("  bash not found; cannot run the winning command."))
        return 127
    except KeyboardInterrupt:
        print(style.red("\n  (interrupted)"))
        return 130


def show_stats(style):
    s = load_state()
    rate = (100.0 * s["wins"] / s["spins"]) if s["spins"] else 0.0
    print()
    print(style.accent("        🎰  R O U L E T T E   —   S T A T S"))
    print()
    print("  Chips:        " + style.bright(f"{s['chips']} 🪙"))
    print(f"  Spins:        {s['spins']}")
    print(f"  Wins/Losses:  {s['wins']} / {s['losses']}  ({rate:.0f}% win rate)")
    print(f"  Streak:       {s['streak']}  (best {s['best_streak']})")
    print(f"  Biggest win:  {s['biggest_win']} 🪙")
    print(f"  Times broke:  {s['broke_count']} 😬")
    print()
    print(style.dim("  Place a bet:  roulette --bet 10 --on red|black|green|jackpot"))
    if s["chips"] <= 0:
        print(style.dim("  Flat broke?   roulette --beg"))
    return 0


def beg(style):
    """The only way to earn chips back. Broke -> the house spots you 100 (with
    escalating sass). Not broke -> you get mocked for begging with money."""
    state = load_state()
    print()
    if state["chips"] > 0:
        print("  " + style.red("🙅 BEG DENIED"))
        print("  " + random.choice(BEG_INSULTS).format(chips=state["chips"]))
        return 0

    state["broke_count"] += 1
    state["chips"] += 100
    level = min(state["broke_count"], len(BEG_LEVELS))
    print("  " + style.accent("🙏 you grovel before the house…"))
    print("  " + BEG_LEVELS[level - 1])
    print("  balance " + style.bright(f"{state['chips']} 🪙")
          + style.dim(f"    ·    times gone broke: {state['broke_count']}"))
    save_state(state)
    return 0


def settle_bet(style, winner, bet, target):
    """Resolve a bet against the landed pocket, update the bankroll, print the verdict.

    This is printed BEFORE the command runs so the command's output (which is
    just flavor) can't be mistaken for the win/lose result.
    """
    state = load_state()
    won, mult = resolve_bet(target, winner)
    color, kind = slot_color(winner), slot_kind(winner)
    state["spins"] += 1

    pocket = style.slot(color, color.upper())
    if kind == "marquee":
        pocket += style.bright(" ★JACKPOT")
    bet_label = (style.slot(target, target.upper())
                 if target in ("red", "black", "green")
                 else style.bright(target.upper()))

    print()
    print("  " + style.accent("━━ BET RESULT ━━━━━━━━━━━━━━━━━━━━━━━━━━"))
    print(f"  landed on {pocket}    ·    you bet {bet_label}")

    if won:
        profit = bet * mult
        state["streak"] += 1
        streak_bonus = (state["streak"] // 3) * bet
        profit += streak_bonus
        state["chips"] += profit
        state["wins"] += 1
        state["best_streak"] = max(state["best_streak"], state["streak"])
        state["biggest_win"] = max(state["biggest_win"], profit)
        flair = style.bright(f"  🔥 streak x{state['streak']}") if streak_bonus else ""
        print(style.green(f"  ✅ YOU WIN  +{profit} 🪙") + flair
              + "    →    balance " + style.bright(f"{state['chips']} 🪙"))
    else:
        state["chips"] -= bet
        state["losses"] += 1
        state["streak"] = 0
        print(style.red(f"  ❌ YOU LOSE  -{bet} 🪙")
              + "    →    balance " + style.bright(f"{state['chips']} 🪙"))

    if state["chips"] <= 0:
        print(style.dim("  Out of chips — top back up with: roulette --reset"))
    save_state(state)
    return 0


def _derive_color(output):
    """Turn arbitrary command output into red/black via the parity of its number."""
    nums = re.findall(r"\d+", output)
    n = int(nums[-1]) if nums else sum(output.encode("utf-8", "ignore"))
    return ("red" if n % 2 == 0 else "black"), n


def _flash_wheel(style, final, cycles=16):
    """Light up: flash a full bar red/black, decelerating, then settle on `final`."""
    out = sys.stdout
    if not out.isatty() or not style.enabled:
        return
    width = min(term_width(), 56) - 4
    out.write(HIDE_CURSOR)
    try:
        for i in range(cycles):
            c = "red" if i % 2 == 0 else "black"
            out.write("\r  " + style.slot(c, "█" * width))
            out.flush()
            time.sleep(0.03 + (i / cycles) * 0.14)
        out.write("\r  " + style.slot(final, "█" * width) + CLEAR_LINE + "\n")
        out.flush()
    finally:
        out.write(SHOW_CURSOR)
        out.flush()


def super_spin(style, label, entropy_cmd, bet=None, target="red", timeout=15):
    """Wildcard pocket: run the entropy command and turn its output into a color."""
    print()
    print("  " + style.accent("✨✨  S U P E R   S P I N  ✨✨"))
    print(style.dim("  " + label.replace("✨ ", "")))
    print()
    sys.stdout.flush()
    try:
        out = subprocess.run(["bash", "-c", entropy_cmd], capture_output=True,
                             text=True, timeout=timeout).stdout
    except Exception:  # noqa: BLE001
        out = str(random.randint(0, 99999))
    color, n = _derive_color(out)
    raw = (out.strip().splitlines() or [str(n)])[0].strip()
    parity = "even" if n % 2 == 0 else "odd"
    print(f"  🔢 the wheel conjures  {style.bright(raw[:40])}  →  {n} is {parity}")
    _flash_wheel(style, color)
    print("  " + style.slot(color, f"  ◉   {color.upper()}   WINS   ◉  "))

    if bet is None:
        print(style.dim(f"  (no bet — {color.upper()} takes the round)"))
        return 0

    # Settle the bet against the derived color (super spins are red/black only).
    state = load_state()
    state["spins"] += 1
    won = target in ("red", "black") and target == color
    if won:
        profit = bet
        state["streak"] += 1
        bonus = (state["streak"] // 3) * bet
        profit += bonus
        state["chips"] += profit
        state["wins"] += 1
        state["best_streak"] = max(state["best_streak"], state["streak"])
        state["biggest_win"] = max(state["biggest_win"], profit)
        flair = style.bright(f"  🔥 streak x{state['streak']}") if bonus else ""
        print(style.green(f"  ✅ YOU WIN  +{profit} 🪙") + flair
              + "    →    balance " + style.bright(f"{state['chips']} 🪙"))
    else:
        state["chips"] -= bet
        state["losses"] += 1
        state["streak"] = 0
        note = "" if target in ("red", "black") else style.dim(
            f"  (a super spin only pays red/black, not {target})")
        print(style.red(f"  ❌ YOU LOSE  -{bet} 🪙") + note
              + "    →    balance " + style.bright(f"{state['chips']} 🪙"))
    if state["chips"] <= 0:
        print(style.dim("  Out of chips — top back up with: roulette --reset"))
    save_state(state)
    return 0


