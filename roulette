def _finals(history):
    """The number that settled each spin (the super-spin number after a zero)."""
    out = []
    for h in history:
        try:
            out.append(int(str(h).split(">")[-1]))
        except ValueError:
            pass
    return out


def _color_run(nums):
    """(colour, length) of the colour streak at the end of `nums`."""
    if not nums or number_color(nums[-1]) == "green":
        return None, 0
    color, k = number_color(nums[-1]), 0
    for n in reversed(nums):
        if number_color(n) != color:
            break
        k += 1
    return color, k


def _zigzag(nums):
    """How many spins at the end of `nums` alternate red/black."""
    k = 0
    for i in range(len(nums) - 1, -1, -1):
        if number_color(nums[i]) == "green":
            break
        if k and number_color(nums[i]) == number_color(nums[i + 1]):
            break
        k += 1
    return k


def near_miss(bets, first, second):
    """Your inside-bet number right next to where the ball landed, or None."""
    landed, order = (second, SUPER_WHEEL_ORDER) if first == 0 else (first, WHEEL_ORDER)
    if landed is None:
        return None
    mine = set()
    for b in bets:
        if len(b["numbers"]) <= 6:
            mine |= set(b["numbers"])
    if not mine or landed in mine:
        return None
    i = order.index(landed)
    for n in (order[i - 1], order[(i + 1) % len(order)]):
        if n in mine:
            return landed, n
    return None


def pattern_before(style, history, bets):
    """React to what you're betting, given recent spins."""
    nums = _finals(history)
    if not nums or FLAVOR.random() >= 0.6:
        return
    streak, count = _color_run(nums)
    keys = {b["key"] for b in bets}
    if count >= 4 and keys & {"red", "black"}:
        other = "black" if streak == "red" else "red"
        if other in keys and streak not in keys:
            return say(style, "gamblers_fallacy", streak=streak, color=other, count=count)
        if streak in keys and other not in keys:
            return say(style, "ride_streak", streak=streak, count=count)
    last = nums[-1]
    if any(b["numbers"] == frozenset({last}) for b in bets):
        say(style, "chase_last", n=last)


def pattern_after(style, history):
    """React to the wheel's recent behaviour."""
    nums = _finals(history)
    if len(nums) < 2 or FLAVOR.random() >= 0.8:
        return
    color, count = _color_run(nums)
    zig = _zigzag(nums)
    if nums[-1] == nums[-2]:
        say(style, "repeat_number", n=nums[-1])
    elif count in (5, 7, 10) or count >= 12:
        say(style, "color_streak", color=color, count=count)
    elif zig in (6, 8, 10) or zig >= 12:
        say(style, "zigzag", count=zig)


def rare_event(style, state, animate):
    """Once in a while, something happens elsewhere in the casino."""
    if FLAVOR.randrange(RARE_EVENT_ODDS):
        return False
    seen = state["events_seen"] if state is not None else _events_seen
    unseen = [i for i in range(len(RARE_EVENTS)) if i not in seen]
    if not unseen:
        seen.clear()
        unseen = list(range(len(RARE_EVENTS)))
    pick = FLAVOR.choice(unseen)
    seen.append(pick)
    if state is not None:
        save_state(state)
    print()
    emit("  " + style.accent("🎪  M E A N W H I L E …"))
    for line in RARE_EVENTS[pick]:
        emit("  " + style.dim(fx(line)))
        sys.stdout.flush()
        if animate:
            pause(0.9)
    return True


def leave_table(style, state):
    """Say goodbye, according to how the night went."""
    chips = state["chips"]
    if chips <= 0:
        mood = "last_chance" if state["run_begs"] >= MAX_BEGS - 1 else "broke"
    elif chips >= GOAL * 0.7:
        mood = "close"
    elif chips > STARTING_CHIPS:
        mood = "up"
    elif chips == STARTING_CHIPS:
        mood = "even"
    else:
        mood = "down"
    emit(style.dim(f"  You leave the table with {chips} 🪙."))
    emit("  " + fx(FLAVOR.choice(EXIT_LINES[mood]), chips=chips, gap=GOAL - chips,
                    up=chips - STARTING_CHIPS, down=STARTING_CHIPS - chips))
    who = "honest" if state["honest"] else "friend" if luck(state) > 0 else \
        "spite" if luck(state) < 0 else ""
    if who and FLAVOR.random() < 0.7:
        croak(style, FLAVOR.choice(EXIT_CROUPIER[who]))


def martingale_level(state, stake):
    """How many times in a row the player has doubled their stake after a loss."""
    if state["last_net"] < 0 and state["last_stake"] > 0 and stake >= 2 * state["last_stake"]:
        return state["martingale"] + 1
    return 0


def martingale_quip(style, level, stake):
    if level < 2:
        return
    unit = max(1, stake >> level)
    text = MARTINGALE_QUIPS.get(level, MARTINGALE_MAX)
    croak(style, text, stake=stake, unit=unit, level=level)


