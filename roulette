def pray(style, state):
    """Pray to the roulette gods. It never changes the odds; it does get you judged."""
    state["prayers"] += 1
    state["pray_streak"] += 1
    if state["pray_streak"] > 3:
        mood = "annoyed"
    elif state["chips"] <= 0:
        mood = "broke"
    elif state["honest"]:
        mood = "honest"
    elif luck(state) < 0:
        mood = "cursed"
    elif state["chips"] >= GOAL * 0.8:
        mood = "close"
    elif luck(state) > 0:
        mood = "blessed"
    else:
        mood = "plain"
    emit("  " + style.dim("🙏 You clasp your hands and pray to the roulette gods…"))
    sys.stdout.flush()
    emit("  " + style.accent("⚡ ") + fx(FLAVOR.choice(PRAYERS[mood])))
    if FLAVOR.random() < 0.4:
        croak(style, FLAVOR.choice(PRAYER_CROUPIER))
    save_state(state)
    return True


def swap_table(style, state):
    """Move to another table, with a different croupier. Your luck doesn't transfer.

    Right after a pit-boss bust you're not allowed to move for a while
    (state["heat"] spins), so swapping can't instantly undo getting caught.
    """
    if state["heat"] > 0:
        croak(style, "\"The pit boss wants you right where you are,\" says {name}. "
                     "({n} more spin{s} before you can change tables)",
              n=state["heat"], s="s" if state["heat"] != 1 else "")
        return False
    emit("  " + style.dim(fx("You gather your chips and wave goodbye to {name}.")))
    emit("  " + style.dim("🚶 You move to another table…"))
    replace_dealer(state)
    state["honest"] = 0
    state["tip_log"], state["tip_pending"] = [], 0
    save_state(state)
    croak(style, "Good evening. I'm {name}, and I'll be your croupier this run.")
    emit("  " + style.dim(luck_text(state) + " — a fresh start"))
    if state["run_caught"]:
        emit("  " + style.red(f"👀 The pit boss follows you over. Rigged spins are still "
                               f"{2 ** state['run_caught']}× likelier to be spotted this run."))
