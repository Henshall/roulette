def build_parser():
    p = argparse.ArgumentParser(
        prog="roulette",
        description="Spin a wheel of harmless, read-only commands and run the winner.",
    )
    p.add_argument(
        "-n", "--dry-run", action="store_true",
        help="spin and pick a command, but do not execute it",
    )
    p.add_argument(
        "-l", "--list", action="store_true",
        help="list every command on the wheel and exit",
    )
    p.add_argument(
        "-p", "--pick", "-f", "--fast", action="store_true", dest="pick",
        help="skip the spin animation and run the winner immediately",
    )
    p.add_argument(
        "--keep-wheel", action="store_true",
        help="keep the full wheel on screen after it lands "
             "(default: collapse it once the spin stops)",
    )
    p.add_argument(
        "--russian", action="store_true",
        help="add a 'russian roulette' slot that trashes every file and folder "
             "in the current directory (opt-in; asks before deleting)",
    )
    p.add_argument(
        "--no-color", action="store_true",
        help="disable ANSI colors",
    )
    p.add_argument(
        "--timeout", type=int, default=15, metavar="SECS",
        help="seconds to allow the winning command to run (default: 15)",
    )
    p.add_argument(
        "--seed", type=int, default=None,
        help="seed the random generator (for reproducible spins)",
    )
    bet = p.add_argument_group("betting (persistent bankroll in ~/.roulette)")
    bet.add_argument(
        "--bet", type=int, default=None, metavar="CHIPS",
        help="wager CHIPS on the spin; the pocket you land on settles the bet",
    )
    bet.add_argument(
        "--on", choices=BET_TARGETS, default="red", metavar="TARGET",
        help="what to bet on: red, black, green (the losers), or jackpot",
    )
    bet.add_argument(
        "--stats", action="store_true",
        help="show your bankroll, win rate and streak, then exit",
    )
    bet.add_argument(
        "--beg", action="store_true",
        help="beg the house for chips — the only way to earn them back when broke",
    )
    bet.add_argument(
        "--reset", action="store_true",
        help=f"reset the bankroll to {STARTING_CHIPS} chips and clear stats",
    )
    p.add_argument(
        "-V", "--version", action="version",
        version=f"roulette {__version__}",
    )
    return p


def main(argv=None):
    args = build_parser().parse_args(argv)

    use_color = not args.no_color and sys.stdout.isatty() and os.environ.get("NO_COLOR") is None
    style = Style(use_color)

    # Bankroll management commands (no spin).
    if args.reset:
        save_state(dict(DEFAULT_STATE))
        print(f"Bankroll reset to {STARTING_CHIPS} 🪙.")
        return 0
    if args.stats:
        return show_stats(style)
    if args.beg:
        return beg(style)

    if args.seed is not None:
        random.seed(args.seed)

    wheel = list(COMMANDS)
    if args.russian:
        wheel.append(RUSSIAN)

    if args.list:
        for i, cmd in enumerate(wheel, 1):
            print(f"{i:3d}. {cmd}")
        return 0

    # Betting setup / validation.
    betting = args.bet is not None
    state = None
    if betting:
        if args.russian:
            print("Cannot combine --bet with --russian.", file=sys.stderr)
            return 2
        if args.bet <= 0:
            print("Your bet must be a positive number of chips.", file=sys.stderr)
            return 2
        state = load_state()
        if args.bet > state["chips"]:
            if state["chips"] <= 0:
                print("You're flat broke. Beg for a comeback: roulette --beg",
                      file=sys.stderr)
            else:
                print(f"Not enough chips: you have {state['chips']} 🪙 "
                      f"(try --bet {state['chips']}, or beg: roulette --beg).",
                      file=sys.stderr)
            return 2

    is_tty = sys.stdout.isatty()

    print()
    print(style.accent("        🎰  R O U L E T T E  🎰"))
    if betting:
        print(style.dim(f"     betting {args.bet} 🪙 on ")
              + style.slot(args.on, args.on.upper())
              + style.dim(f"  —  balance {state['chips']} 🪙"))
    elif args.russian:
        print(style.red("     ☠ russian mode — 1 slot trashes everything here ☠"))
    else:
        print(style.dim("     every command is read-only — spin away!"))
    print()

    try:
        if args.pick or not is_tty:
            winner = random.choice(wheel)
            if not is_tty:
                # Non-interactive: don't animate, just report.
                print(f"Picked: {winner}")
        else:
            winner = spin(wheel, style, keep_wheel=args.keep_wheel, color_of=slot_color)
    except KeyboardInterrupt:
        sys.stdout.write(SHOW_CURSOR)
        print(style.red("\n  (spin cancelled)"))
        return 130

    if args.dry_run:
        print()
        if winner == RUSSIAN:
            return russian_roulette(style, dry_run=True)
        if winner in _SUPER_SET:
            print(style.accent("  ✨ Would SUPER SPIN:"), style.bright(winner))
            print(style.dim("  (runs an entropy command and flips it to red/black)"))
            return 0
        print(style.green("  🎯 Would run:"), style.bright(winner))
        if betting:
            won, _ = resolve_bet(args.on, winner)
            print(style.dim(f"  (dry run — bet on {args.on} would "
                            f"{'WIN' if won else 'LOSE'}; no chips moved)"))
        else:
            print(style.dim("  (dry run — nothing executed)"))
        return 0

    # Super-random wildcard pockets run their own entropy-driven reveal.
    if winner in _SUPER_SET:
        return super_spin(style, winner, SUPER_CMD[winner],
                          bet=(args.bet if betting else None),
                          target=args.on, timeout=args.timeout)

    if betting:
        # Verdict first (the money), then the command as a clearly-labeled bonus
        # so its flavor output can't be read as the win/lose result.
        settle_bet(style, winner, args.bet, args.on)
        return run_command(
            winner, style, args.timeout,
            header="  🎯 Your spin landed on:", header_color="accent",
        )
    return run_command(winner, style, args.timeout)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.stdout.write(SHOW_CURSOR)
        sys.exit(130)
