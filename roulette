FIREWORK_STAGES = [
    ["", "", "     *     ", "", ""],
    ["", "    \\|/    ", "   --*--   ", "    /|\\    ", ""],
    ["  .  '  .  ", "   \\ | /   ", " ' - * - ' ", "   / | \\   ", "  '  .  '  "],
    ["  .     .  ", " .       . ", "'         '", " .       . ", "  '     '  "],
    ["     .     ", "  .     .  ", "           ", "  '     '  ", "     '     "],
    ["", "", "", "", ""],
]
FIREWORK_COLORS = ("1;31", "1;33", "1;35", "1;36", "1;32", "1;97")


def fireworks(style, animate, bursts=5):
    """A tiny ASCII fireworks show for a straight-up hit."""
    width = max(24, min(term_width(), 72) - 4)
    rows = len(FIREWORK_STAGES[0])
    shows = [(FLAVOR.randrange(0, width - 11), FLAVOR.randrange(0, 4),
              FLAVOR.choice(FIREWORK_COLORS)) for _ in range(bursts)]

    def frame(t):
        grid = [[(" ", None)] * width for _ in range(rows)]
        for x, start, color in shows:
            stage = t - start
            if not 0 <= stage < len(FIREWORK_STAGES):
                continue
            for r, line in enumerate(FIREWORK_STAGES[stage]):
                for c, ch in enumerate(line):
                    if ch != " ":
                        grid[r][x + c] = (ch, color)
        return ["  " + "".join(style._wrap(col, ch) if col else ch for ch, col in row)
                for row in grid]

    out = sys.stdout
    if not animate:
        print("\n".join(frame(2)))
        return
    total = len(FIREWORK_STAGES) + 4
    out.write(HIDE_CURSOR)
    try:
        for t in range(total):
            if t and _ANIM["skip"]:
                break
            if t:
                out.write(f"\033[{rows}A")
            out.write("\r" + "\n".join(l + CLEAR_LINE for l in frame(t)) + "\n")
            out.flush()
            pause(0.11)
        out.write(f"\033[{rows}A\033[J")
    finally:
        out.write(SHOW_CURSOR)
        out.flush()


def tip_croupier(style, state, amount, free=None):
    """Slip the croupier some chips. Recent tips buy help on losing spins.

    Tipping 0 is allowed. The croupier is offended, and your luck goes down.
    """
    free = state["chips"] if free is None else free
    # Can you even afford it? Checked first, so a broke player hears about the
    # empty pockets rather than getting a lecture on honesty.
    if amount < 0:
        croak(style, "A negative tip? {name} is not falling for that one again.")
        return False
    if amount > 0 and free <= 0:
        croak(style, "You can't tip with no chips. {name} appreciates the thought, though.")
        return False
    if amount > free:
        croak(style, "You only have {free} 🪙 to tip with. {name} admires the ambition.",
              free=free)
        return False
    if state["honest"] and amount > 0:
        say(style, "honest_tip")
        return False
    if amount == 0:
        say(style, "tip_zero")
        state["tip_pending"] += ZERO_TIP_PENALTY
        clamp_tips(state)
        emit("  " + style.red(luck_text(state)))
        save_state(state)
        return True
    was_maxed = help_chance(state) >= HELP_MAX
    state["chips"] -= amount
    state["tips"] += amount
    state["run_tipped"] += amount
    state["tip_pending"] += amount
    clamp_tips(state)
