def build_parser():
    p = argparse.ArgumentParser(
        prog="roulette",
        description="A zero-edge roulette table in your terminal. Use --spin to just "
                    "watch the wheel, or --command (or --russian) for the wheel of "
                    "shell commands.",
    )
    mode = p.add_argument_group("modes")
    mode.add_argument(
        "--spin", action="store_true",
        help="spin the real wheel once, just to watch: no bet, and no chips, stats "
             "or history touched",
    )
    mode.add_argument(
        "--command", "--commands", action="store_true", dest="commands",
        help="spin the wheel of harmless, read-only shell commands and run the winner",
    )
    mode.add_argument(
        "--russian", action="store_true",
        help="command wheel plus a 'russian roulette' slot that trashes every file "
             "and folder in the current directory (opt-in; asks before deleting)",
    )
    mode.add_argument(
        "--table", action="store_true",
        help="show the roulette table and every payout, then exit",
    )
    p.add_argument(
        "-n", "--dry-run", action="store_true",
        help="spin, but don't move chips (or, in command mode, run anything)",
    )
    p.add_argument(
        "-l", "--list", action="store_true",
        help="list every command on the command wheel and exit",
    )
    p.add_argument(
        "-p", "--pick", "-f", "--fast", action="store_true", dest="pick",
        help="skip the spin animation",
    )
    p.add_argument(
        "--keep-wheel", action="store_true",
        help="command mode: keep the full wheel on screen after it lands",
    )
    p.add_argument(
        "--no-color", action="store_true",
        help="disable ANSI colors",
    )
    p.add_argument(
        "--timeout", type=int, default=15, metavar="SECS",
        help="command mode: seconds to allow the winning command to run (default: 15)",
    )
    p.add_argument(
        "--seed", type=int, default=None,
        help="seed the random generator (for reproducible spins)",
    )
    bet = p.add_argument_group("betting (persistent bankroll in ~/.roulette)")
    bet.add_argument(
        "--bet", type=int, default=None, metavar="CHIPS",
        help="wager CHIPS on a single spin instead of sitting down at the table",
    )
    bet.add_argument(
        "--on", default="red", metavar="TARGET",
        help="what to bet on: red, black, odd, even, low, high, d1-d3, col1-col3, "
             "0-36, splits like 17/18, streets like 7-9 ... "
             "(command mode: red, black, green or jackpot)",
    )
    bet.add_argument(
        "--swap-table", action="store_true",
        help="move to another table with a new croupier (your luck starts over at 0)",
    )
    bet.add_argument(
        "--pray", action="store_true",
        help="pray to the roulette gods (it doesn't change the odds)",
    )
    bet.add_argument(
        "--tip", type=int, default=None, metavar="CHIPS",
        help=f"tip the croupier; each chip is +{HELP_PER_CHIP * 100:g}%% luck (max "
             f"{HELP_MAX * 100:.0f}%%) that a losing spin gets rigged your way, fading "
             f"over {TIP_WINDOW} spins, until the pit boss catches you",
    )
    bet.add_argument(
        "--stats", action="store_true",
        help="show your bankroll, win rate and streak, then exit",
    )
    bet.add_argument(
        "--beg", action="store_true",
        help=f"beg the house for chips — the only way to earn them back when broke "
             f"(beg {MAX_BEGS} times in one run and you're thrown out: game over)",
    )
    bet.add_argument(
        "--reset", action="store_true",
        help=f"reset the bankroll to {STARTING_CHIPS} chips and clear stats",
    )
    p.add_argument(
        "-V", "--version", action="version",
        version=f"roulette {__version__}",
    )
    return p


def _check_bankroll(bet):
    """Return an error message if `bet` chips can't be wagered, else None."""
    if bet <= 0:
        return "Your bet must be a positive number of chips."
    state = load_state()
    if bet > state["chips"]:
        if state["chips"] <= 0:
            return "You're flat broke. Beg for a comeback: roulette --beg"
        return (f"Not enough chips: you have {state['chips']} 🪙 "
                f"(try --bet {state['chips']}, or beg: roulette --beg).")
    return None


def casino_main(args, style):
    """The real, zero-edge roulette table."""
    if args.table:
        print_table(style)
        return 0

    if args.spin:
        # Just watch: no bets, and no state, so nothing is saved or counted.
        with skippable():
            play_round(style, [], animate=sys.stdout.isatty() and not args.pick,
                       dry_run=True)
        return 0

    interactive_ok = sys.stdin.isatty() and sys.stdout.isatty()
    animate = sys.stdout.isatty() and not args.pick

    if args.bet is None:
        if interactive_ok and not args.dry_run:
            return interactive(style, animate=animate)
        # Non-interactive (or a dry run) with no bet: just spin the wheel.
        with skippable():
            play_round(style, [], animate=animate, dry_run=True)
        return 0

    try:
        bet = parse_target(args.on)
    except ValueError as exc:
        print(f"roulette: {exc}", file=sys.stderr)
        print(BET_HELP, file=sys.stderr)
        return 2
    if not args.dry_run:
        err = _check_bankroll(args.bet)
        if err:
            print(err, file=sys.stderr)
            return 2
    bet["stake"] = args.bet
    state = load_state()
    print()
    emit(style.accent("        🎰  R O U L E T T E  🎰"))
    emit(style.dim(f"     {args.bet} 🪙 on {bet['label']} (pays {bet['payout']}:1)"
                    f"  —  balance {state['chips']} 🪙"))
    with skippable():
        play_round(style, [bet], animate=animate, dry_run=args.dry_run, state=state)
    return 0


def commands_main(args, style):
    """The original wheel of harmless commands (plus the optional russian slot)."""
    wheel = list(COMMANDS)
    if args.russian:
        wheel.append(RUSSIAN)

    if args.list:
        for i, cmd in enumerate(wheel, 1):
            print(f"{i:3d}. {cmd}")
        return 0

    betting = args.bet is not None
    state = None
    if betting:
        if args.russian:
            print("Cannot combine --bet with --russian.", file=sys.stderr)
            return 2
        if args.on not in BET_TARGETS:
            print(f"In command mode, bet --on one of: {', '.join(BET_TARGETS)}.",
                  file=sys.stderr)
            return 2
        err = _check_bankroll(args.bet)
        if err:
            print(err, file=sys.stderr)
            return 2
        state = load_state()

    is_tty = sys.stdout.isatty()

    print()
    emit(style.accent("        🎰  R O U L E T T E  🎰"))
    if betting:
        emit(style.dim(f"     betting {args.bet} 🪙 on ")
              + style.slot(args.on, args.on.upper())
              + style.dim(f"  —  balance {state['chips']} 🪙"))
    elif args.russian:
        emit(style.red("     ☠ russian mode — 1 slot trashes everything here ☠"))
    else:
        emit(style.dim("     every command is read-only — spin away!"))
    print()

    try:
        if args.pick or not is_tty:
            winner = random.choice(wheel)
            if not is_tty:
                print(f"Picked: {winner}")
        else:
            winner = spin(wheel, style, keep_wheel=args.keep_wheel, color_of=slot_color)
    except KeyboardInterrupt:
        sys.stdout.write(SHOW_CURSOR)
        print(style.red("\n  (spin cancelled)"))
        return 130

    if args.dry_run:
        print()
        if winner == RUSSIAN:
            return russian_roulette(style, dry_run=True)
        if winner in _SUPER_SET:
            emit(style.accent("  ✨ Would SUPER SPIN:"), style.bright(winner))
            emit(style.dim("  (runs an entropy command and flips it to red/black)"))
            return 0
        emit(style.green("  🎯 Would run:"), style.bright(winner))
        if betting:
            if args.on in ("red", "black") and slot_color(winner) == "green":
                verdict = "get a SECOND CHANCE super spin"
            else:
                verdict = "WIN" if resolve_bet(args.on, winner)[0] else "LOSE"
            emit(style.dim(f"  (dry run — bet on {args.on} would {verdict}; no chips moved)"))
        else:
            emit(style.dim("  (dry run — nothing executed)"))
        return 0

    # Super-random wildcard pockets run their own entropy-driven reveal.
    if winner in _SUPER_SET:
        return super_spin(style, winner, SUPER_CMD[winner],
                          bet=(args.bet if betting else None),
                          target=args.on, timeout=args.timeout)

    if betting:
        # A green "house" pocket is like a 0: red/black bets aren't lost, they
        # get a second-chance super spin (no house edge on even money).
        if args.on in ("red", "black") and slot_color(winner) == "green":
            print()
            emit("  " + style.slot("green", "GREEN house pocket")
                  + style.dim(" — but there's no house edge here…"))
            run_command(winner, style, args.timeout,
                        header="  🎯 Your spin landed on:", header_color="accent")
            label_, cmd_ = random.choice(SUPER_SLOTS)
            return super_spin(style, "✨ SUPER SPIN — second chance (" +
                              label_.split("— ", 1)[-1] + ")", cmd_,
                              bet=args.bet, target=args.on, timeout=args.timeout)
        # Verdict first (the money), then the command as a clearly-labeled bonus
        # so its flavor output can't be read as the win/lose result.
        settle_bet(style, winner, args.bet, args.on)
        return run_command(
            winner, style, args.timeout,
            header="  🎯 Your spin landed on:", header_color="accent",
        )
    return run_command(winner, style, args.timeout)


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.spin:
        clash = [flag for flag, on in (("--bet", args.bet is not None),
                                       ("--tip", args.tip is not None),
                                       ("--command", args.commands),
                                       ("--russian", args.russian)) if on]
        if clash:
            parser.error(f"--spin just watches the wheel; it can't be combined with "
                         f"{', '.join(clash)}")

    use_color = not args.no_color and sys.stdout.isatty() and os.environ.get("NO_COLOR") is None
    style = Style(use_color)

    # Bankroll management commands (no spin).
    if args.reset:
        save_state(fresh_state())
        ensure_dealer(load_state())
        print(f"Bankroll reset to {STARTING_CHIPS} 🪙.")
        return 0
    ensure_dealer(load_state())
    _ANIM["fast"] = bool(load_state()["fast"])
    if args.stats:
        return show_stats(style)
    if args.beg:
        return beg(style, animate=sys.stdout.isatty())
    if args.pray:
        print()
        pray(style, load_state())
        if args.bet is None and args.tip is None and not args.swap_table:
            return 0
    if args.swap_table:
        print()
        ok = swap_table(style, load_state())
        if args.bet is None and args.tip is None:
            return 0 if ok else 1
    if args.tip is not None:
        print()
        ok = tip_croupier(style, load_state(), args.tip)
        if args.bet is None:
            return 0 if ok else 1

    if args.seed is not None:
        random.seed(args.seed)

    if args.commands or args.russian or args.list:
        return commands_main(args, style)
    return casino_main(args, style)


def run():
    """Command-line entry point (also used by the pip/pipx-installed command)."""
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.stdout.write(SHOW_CURSOR)
        sys.exit(130)


if __name__ == "__main__":
    run()
