# The optional 101st slot, added only with --russian. This is NOT a bash
# command string; it is a sentinel handled specially by russian_roulette().
RUSSIAN = "☠  RUSSIAN ROULETTE  ☠  (send everything here to the trash)"


# ---------------------------------------------------------------------------
# ANSI helpers
# ---------------------------------------------------------------------------
class Style:
    def __init__(self, enabled):
        self.enabled = enabled

    def _wrap(self, code, text):
        if not self.enabled:
            return text
        return f"\033[{code}m{text}\033[0m"

    def dim(self, t):
        return self._wrap("2;37", t)

    def bright(self, t):
        return self._wrap("1;33", t)

    def win(self, t):
        return self._wrap("1;30;43", t)  # black on yellow

    def accent(self, t):
        return self._wrap("1;36", t)

    def green(self, t):
        return self._wrap("1;32", t)

    def red(self, t):
        return self._wrap("1;31", t)


HIDE_CURSOR = "\033[?25l"
SHOW_CURSOR = "\033[?25h"
CLEAR_LINE = "\033[K"


def term_width(default=80):
    try:
        return shutil.get_terminal_size((default, 24)).columns
    except Exception:
        return default


def label(cmd, width):
    """One-line display label for a command (truncate if needed)."""
    cmd = cmd.replace("\n", " ")
    if len(cmd) > width:
        cmd = cmd[: width - 1] + "…"
    return cmd


# ---------------------------------------------------------------------------
# The spin animation
# ---------------------------------------------------------------------------
def spin(commands, style, *, frames=55, window=7, keep_wheel=False):
    """Animate a scrolling reel and return the winning command."""
    width = min(term_width(), 72)
    inner = width - 10  # room for the pointer/markers
    half = window // 2

    # Build a reel long enough to scroll through `frames` positions.
    reel = []
    pool = commands[:]
    needed = frames + window + 4
    while len(reel) < needed:
        random.shuffle(pool)
        reel.extend(pool)

    # Ease-out delays: start fast, end slow.
    start_delay, end_delay = 0.010, 0.22
    delays = []
    for i in range(frames):
        t = i / (frames - 1) if frames > 1 else 1.0
        delays.append(start_delay + (end_delay - start_delay) * (t ** 2.3))

    bar = "═" * (width - 2)
    top = "╔" + bar + "╗"
    bottom = "╚" + bar + "╝"
    block_lines = window + 2  # borders

    def render(center_idx):
        lines = [style.accent(top)]
        for off in range(-half, half + 1):
            cmd = reel[center_idx + off]
            text = label(cmd, inner)
            if off == 0:
                content = f" ▶  {text}"
                content = content.ljust(width - 6)
                row = "║ " + style.win(content) + " ◀ ║"
            else:
                faded = style.dim(text)
                pad = width - 4 - len(label(cmd, inner))
                row = "║  " + faded + (" " * max(pad, 0)) + " ║"
            lines.append(row)
        lines.append(style.accent(bottom))
        return lines

    out = sys.stdout
    out.write(HIDE_CURSOR)
    winner = reel[half]
    try:
        for f in range(frames):
            center = half + f
            winner = reel[center]
            lines = render(center)
            if f > 0:
                out.write(f"\033[{block_lines}A")  # move cursor up to redraw
            out.write("\r")
            out.write(("\n").join(l + CLEAR_LINE for l in lines))
            out.write("\n")
            out.flush()
            time.sleep(delays[f])
        if not keep_wheel:
            time.sleep(0.4)                       # let the landing register
            out.write(f"\033[{block_lines}A")     # back to the top of the box
            out.write("\033[J")                   # erase the box (and below)
            out.flush()
    finally:
        out.write(SHOW_CURSOR)
        out.flush()
    return winner


def _list_entries():
    """Every file and folder in the current directory (names only, incl. dotfiles)."""
    return sorted(os.listdir("."))


def _trash_path(path):
    """Move a file or folder to the trash (recoverable). Returns where it went."""
    # Prefer the desktop trash via gio: restorable from the file manager.
    if shutil.which("gio"):
        r = subprocess.run(
            ["gio", "trash", path],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
        if r.returncode == 0:
            return "Trash"
    # Fallback: move into a timestamped recovery folder under $HOME.
    stamp = time.strftime("%Y%m%d-%H%M%S")
    dest = os.path.join(os.path.expanduser("~"), ".local", "share",
                        "roulette-trash", stamp)
    os.makedirs(dest, exist_ok=True)
    shutil.move(path, os.path.join(dest, os.path.basename(path.rstrip("/"))))
    return dest


def russian_roulette(style, dry_run):
    """The russian slot: move every file and folder in the current dir to the trash."""
    entries = _list_entries()
    print()
    print(style.red("  ☠  R U S S I A N   R O U L E T T E  ☠"))
    print(style.dim("  Chamber: " + os.getcwd()))
    print()

    if not entries:
        print(style.green("  This directory is empty — *click*. You live."))
        return 0

    print(style.dim("  In the chamber:"))
    for e in entries:
        tag = "/" if os.path.isdir(e) and not os.path.islink(e) else ""
        print("    - " + e + tag)
    print()

    if dry_run:
        print(style.dim("  (dry run — nothing deleted)"))
        return 0

    if not sys.stdin.isatty():
        print(style.red("  Refusing to delete without an interactive confirmation."))
        return 1

    print(style.red(f"  All {len(entries)} item(s) here will be moved to the TRASH (recoverable)."))
    try:
        ans = input("  Type 'bang' to pull the trigger (anything else = chicken out): ")
    except (EOFError, KeyboardInterrupt):
        print(style.green("\n  You chickened out. Everything is safe."))
        return 0
    if ans.strip().lower() != "bang":
        print(style.green("  You chickened out. Everything is safe."))
        return 0

    trashed, failed, where = [], [], "Trash"
    for e in entries:
        try:
            where = _trash_path(e)
            trashed.append(e)
        except Exception as exc:  # noqa: BLE001
            failed.append((e, exc))

    print()
    if trashed:
        print(style.red(f"  💥 BANG. Trashed {len(trashed)} item(s): ")
              + ", ".join(trashed))
        print(style.dim(f"  Recover from: {where}"))
    for e, exc in failed:
        print(style.red(f"  Could not trash {e}: {exc}"))
    return 0 if not failed else 1


def run_command(cmd, style, timeout):
    if cmd == RUSSIAN:
        return russian_roulette(style, dry_run=False)
    print()
    print(style.green("  🎯 Landed on:"), style.bright(cmd))
    print(style.dim("  " + "─" * 50))
    print()
    sys.stdout.flush()  # ensure our header prints before the subprocess output
    try:
        result = subprocess.run(
            ["bash", "-c", cmd],
            timeout=timeout,
        )
        return result.returncode
    except subprocess.TimeoutExpired:
        print(style.red(f"\n  (command timed out after {timeout}s)"))
        return 124
    except FileNotFoundError:
        print(style.red("  bash not found; cannot run the winning command."))
        return 127
    except KeyboardInterrupt:
        print(style.red("\n  (interrupted)"))
        return 130


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------
def build_parser():
    p = argparse.ArgumentParser(
        prog="roulette",
        description="Spin a wheel of harmless, read-only commands and run the winner.",
    )
    p.add_argument(
        "-n", "--dry-run", action="store_true",
        help="spin and pick a command, but do not execute it",
    )
    p.add_argument(
        "-l", "--list", action="store_true",
        help="list every command on the wheel and exit",
    )
    p.add_argument(
        "-p", "--pick", "-f", "--fast", action="store_true", dest="pick",
        help="skip the spin animation and run the winner immediately",
    )
    p.add_argument(
        "--keep-wheel", action="store_true",
        help="keep the full wheel on screen after it lands "
             "(default: collapse it once the spin stops)",
    )
    p.add_argument(
        "--russian", action="store_true",
        help="add a 'russian roulette' slot that trashes every file and folder "
             "in the current directory (opt-in; asks before deleting)",
    )
    p.add_argument(
        "--no-color", action="store_true",
        help="disable ANSI colors",
    )
    p.add_argument(
        "--timeout", type=int, default=15, metavar="SECS",
        help="seconds to allow the winning command to run (default: 15)",
    )
    p.add_argument(
        "--seed", type=int, default=None,
        help="seed the random generator (for reproducible spins)",
    )
    p.add_argument(
        "-V", "--version", action="version",
        version=f"roulette {__version__}",
    )
    return p


def main(argv=None):
    args = build_parser().parse_args(argv)

    if args.seed is not None:
        random.seed(args.seed)

    use_color = not args.no_color and sys.stdout.isatty() and os.environ.get("NO_COLOR") is None
    style = Style(use_color)

    wheel = list(COMMANDS)
    if args.russian:
        wheel.append(RUSSIAN)

    if args.list:
        for i, cmd in enumerate(wheel, 1):
            print(f"{i:3d}. {cmd}")
        return 0

    is_tty = sys.stdout.isatty()

    print()
    print(style.accent("        🎰  R O U L E T T E  🎰"))
    if args.russian:
        print(style.red("     ☠ russian mode — 1 slot trashes everything here ☠"))
    else:
        print(style.dim("     every command is read-only — spin away!"))
    print()

    try:
        if args.pick or not is_tty:
            winner = random.choice(wheel)
            if not is_tty:
                # Non-interactive: don't animate, just report.
                print(f"Picked: {winner}")
        else:
            winner = spin(wheel, style, keep_wheel=args.keep_wheel)
    except KeyboardInterrupt:
        sys.stdout.write(SHOW_CURSOR)
        print(style.red("\n  (spin cancelled)"))
        return 130

    if args.dry_run:
        print()
        if winner == RUSSIAN:
            return russian_roulette(style, dry_run=True)
        print(style.green("  🎯 Would run:"), style.bright(winner))
        print(style.dim("  (dry run — nothing executed)"))
        return 0

    return run_command(winner, style, args.timeout)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.stdout.write(SHOW_CURSOR)
        sys.exit(130)
